{
  "name": "خطتي الأكاديمية — كلية العلوم إسكندرية",
  "short_name": "خطتي",
  "description": "خطة دراسية تفاعلية لقسم الرياضيات وعلوم الحاسب: حاسب + إحصاء وشعبة السبيشيال، مع حاسبة المعدل وخريطة المتطلبات السابقة. تعمل بدون إنترنت.",
  "lang": "ar",
  "dir": "rtl",
  "start_url": "./index.html",
  "scope": "./",
  "id": "uni-planner-alex-cs",
  "display": "standalone",
  "display_override": [
    "standalone",
    "minimal-ui",
    "browser"
  ],
  "orientation": "any",
  "background_color": "#000000",
  "theme_color": "#000000",
  "categories": [
    "education",
    "productivity",
    "utilities"
  ],
  "prefer_related_applications": false,
  "icons": [
    {
      "src": "./assets/icons/favicon.svg",
      "sizes": "any",
      "type": "image/svg+xml"
    },
    {
      "src": "./assets/icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./assets/icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./assets/icons/maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "حاسب + إحصاء",
      "short_name": "حاسب+إحصاء",
      "description": "خطة التخصص المزدوج",
      "url": "./modules/cs-stat/index.html",
      "icons": [
        {
          "src": "./assets/icons/icon-192.png",
          "sizes": "192x192"
        }
      ]
    },
    {
      "name": "سبيشيال",
      "short_name": "سبيشيال",
      "description": "خطة الشعبة الخاصة",
      "url": "./modules/cs-special/index.html",
      "icons": [
        {
          "src": "./assets/icons/icon-192.png",
          "sizes": "192x192"
        }
      ]
    },
    {
      "name": "نسخة احتياطية",
      "short_name": "نسخة",
      "description": "تصدير واستيراد بياناتك",
      "url": "./diagnostics.html",
